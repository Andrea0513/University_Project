*-------------------------------------------------------------------------
* Assegnati due vettori A e B di 10 word ciascuno sviluppare un programma
* per il processore Motorola 68000 che:
* 2) Crei un vettore C di 10 word tale che C[i]=A[i] se B[i]=0,
*    altrimenti si ponga C[i]=1.
*-------------------------------------------------------------------------

        ORG     $8000
A       DC.W    15,22,8,14,30,11,9,4,18,7
B       DC.W    1,0,3,0,0,2,8,0,5,1
C       DS.W    10
DIM     DC.W    10

        ORG     $8100
MAIN:   
        MOVE.L  #A,-(SP)        //14-18
        MOVE.L  #B,-(SP)        //10-14
        MOVE.L  #C,-(SP)        //6-10
        MOVE.W  DIM,-(SP)       //4-6
        JSR     RIEMP           //0-4
        ADDA.L  #14,SP
FINE:   
        JMP     FINE

        ORG     $8200
RIEMP:  
        MOVEA.L 14(SP),A0       //A
        MOVEA.L 10(SP),A1       //B
        MOVEA.L 6(SP),A2        //C
        MOVE.W  4(SP),D0        //DIM
        CLR.W   D1              //INDICE
LOOP:   
        CMP.W   D0,D1
        BEQ     FINE_C
        MOVE.W  (A0)+,D2
        MOVE.W  (A1)+,D3
        CMP.W   #0,D3
        BEQ     CC
        MOVE.W  #1,(A2)+
        BRA     INCR
CC:     
        MOVE.W  D2,(A2)+
INCR:   
        ADDQ.W  #1,D1
        BRA     LOOP
FINE_C: 
        RTS

        END